20 0 obj
<< /Length 2165 >>
stream
BT
/F1 12 Tf
1 0 0 1 50 742 Tm
14 TL
(```python) Tj
T*
(class GestureRobotSystem:) Tj
T*
(    def __init__\\(self\\):) Tj
T*
(        self.hand_tracker = HandTracker\\(\\)) Tj
T*
(        self.model = GestureTransformer\\(\\)) Tj
T*
(        self.nlp = GestureNLP\\(\\)) Tj
T*
(        self.blockchain = BlockchainBridge\\(\\)) Tj
T*
(        self.robot = WebotsController\\(\\)) Tj
T*
(        self.frame_buffer = deque\\(maxlen=60\\)) Tj
T*
(    ) Tj
T*
(    def run\\(self\\):) Tj
T*
(        while True:) Tj
T*
(            # 1. Capture frame and extract landmarks) Tj
T*
(            frame = self.capture_frame\\(\\)) Tj
T*
(            landmarks = self.hand_tracker.process\\(frame\\)) Tj
T*
(            ) Tj
T*
(            # 2. Buffer landmarks) Tj
T*
(            self.frame_buffer.append\\(landmarks\\)) Tj
T*
(            ) Tj
T*
(            # 3. Predict gesture when buffer is full) Tj
T*
(            if len\\(self.frame_buffer\\) == 60:) Tj
T*
(                gesture = self.model.predict\\(self.frame_buffer\\)) Tj
T*
(                ) Tj
T*
(                # 4. Convert to command) Tj
T*
(                command = self.nlp.parse\\(gesture\\)) Tj
T*
(                ) Tj
T*
(                # 5. Log to blockchain) Tj
T*
(                self.blockchain.log_command\\(command\\)) Tj
T*
(                ) Tj
T*
(                # 6. Execute on robot) Tj
T*
(                self.robot.execute\\(command\\)) Tj
T*
(```) Tj
T*
() Tj
T*
(8.2 Processing Loop) Tj
T*
(-------------------) Tj
T*
() Tj
T*
(1. CAPTURE: Read webcam frame, extract landmarks, add to buffer) Tj
T*
(2. PREDICT: When buffer full \\(60 frames\\), run Transformer model) Tj
T*
(3. INTERPRET: NLP converts gesture class to robot command) Tj
T*
(4. LOG: Hash command and send to blockchain) Tj
T*
(5. EXECUTE: Send motor commands to Webots robot) Tj
T*
(6. LOOP: Repeat at 30 FPS) Tj
T*
() Tj
T*
(================================================================================) Tj
T*
(9. INSTALLATION AND SETUP GUIDE) Tj
T*
(================================================================================) Tj
T*
() Tj
T*
(9.1 Prerequisites) Tj
T*
(-----------------) Tj
